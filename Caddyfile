:{$PORT} {
  # The portfolio stays on its own hostname while the SRX public site owns the
  # apex domain. Both are served by the same small, stateless web service.
  @portfolio host resume.srxnexus.org
  handle @portfolio {
    root * /srv
    file_server
  }

  # The Realm site used to live below /realm on GitHub Pages. Its files are
  # now the public root of srxnexus.org.
  handle {
    root * /srv/realm
    file_server
  }
}

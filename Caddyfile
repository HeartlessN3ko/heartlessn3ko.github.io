:{$PORT} {
  # The portfolio stays on its own hostname while the SRX public site owns the
  # apex domain. Both are served by the same small, stateless web service.
  @portfolio host resume.srxnexus.org
  handle @portfolio {
    root * /srv
    file_server
  }

  # This is a separate independent publication, deliberately distinct from the
  # fictional SRX website at the apex domain.
  @publication host blog.srxnexus.org
  handle @publication {
    root * /srv/blog
    file_server
  }

  # Railway's current plan has no additional custom-domain slot. Keep the
  # independent publication available from the main domain in the meantime.
  @publicationPath path /blog
  redir @publicationPath /blog/
  handle_path /blog/* {
    root * /srv/blog
    file_server
  }

  # Public, cross-linked reading edition of the Laws of Humanity.
  @humanityPath path /humanity
  redir @humanityPath /humanity/
  handle_path /humanity/* {
    root * /srv/humanity
    file_server
  }

  # Discovery files live at the site root, where search crawlers expect them.
  @searchDiscovery path /robots.txt /sitemap.xml
  handle @searchDiscovery {
    root * /srv
    file_server
  }

  # The Realm site used to live below /realm on GitHub Pages. Its files are
  # now the public root of srxnexus.org.
  handle {
    root * /srv/realm
    file_server
  }
}
